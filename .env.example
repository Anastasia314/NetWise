# Application Settings
APP_NAME=NetWise

# Database Settings
DATABASE_URL=postgresql://user:password@localhost:5432/netwise
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Telegram Bot Settings
TELEGRAM_BOT_TOKEN=your_bot_token_here
